{
  "manifest_version": 3,
  "name": "City Amjhupi",
  "version": "2.4.0",
  "minimum_chrome_version": "141",
  "description": "City Amjhupi customer documents and operator-controlled City Bank eKYC autofill.",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://citybank.abmgroup.tech/*",
    "https://dob-ab.citybankplc.com/*"
  ],
  "content_scripts": [{"matches":["https://dob-ab.citybankplc.com/admin/onboarding*"],"js":["autofill-content.js"],"run_at":"document_idle"}],
  "action": {
    "default_title": "Open City Amjhupi",
    "default_icon": {
      "128": "city-logo.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "icons": {
    "128": "city-logo.png"
  }
}
